  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:owner": "playwright test --project=owner --workers 1",
    "test:sysadmin": "playwright test --project=sysadmin --workers 1",
    "test:coach": "playwright test --project=coach --workers 1",
    "test:parent": "playwright test --project=parent --workers 1",
    "test:athlete": "playwright test --project=athlete --workers 1",
    "test:setup": "playwright test --project=setup --workers 1",
    "test:all": "npx concurrently \"npm run test:owner --ignore-scripts\" \"npm run test:sysadmin --ignore-scripts\" \"npm run test:coach --ignore-scripts\" \"npm run test:parent --ignore-scripts\" \"npm run test:athlete --ignore-scripts\"",
    "typecheck": "tsc --noEmit",
    "pretest:owner": "npm run typecheck",
    "pretest:sysadmin": "npm run typecheck",
    "pretest:coach": "npm run typecheck",
    "pretest:parent": "npm run typecheck",
    "pretest:athlete": "npm run typecheck",
    "pretest:setup": "npm run typecheck",
    "pretest:all": "npm run typecheck"
  },
  "keywords": [],
