  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
